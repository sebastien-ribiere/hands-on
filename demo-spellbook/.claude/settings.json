{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GOLDEN_THREAD_BIN=\"${CLAUDE_PROJECT_DIR}/../golden-thread-cli/bin/golden-thread\" python3 \"${CLAUDE_PROJECT_DIR}/../claude-code-adapter/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "GOLDEN_THREAD_BIN=\"${CLAUDE_PROJECT_DIR}/../golden-thread-cli/bin/golden-thread\" python3 \"${CLAUDE_PROJECT_DIR}/../claude-code-adapter/hooks/pre_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
