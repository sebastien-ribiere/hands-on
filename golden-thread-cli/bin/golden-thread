#!/usr/bin/env bash
# Run the CLI straight from the source tree, with no install step.
# `pip install -e golden-thread-cli` gives the same command on PATH.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec env GOLDEN_THREAD_SELF="${here}/golden-thread" PYTHONPATH="${here}/../src${PYTHONPATH:+:$PYTHONPATH}" python3 -m golden_thread "$@"
